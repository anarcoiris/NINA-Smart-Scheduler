# Copy to .env and adjust, or export these directly in your shell / MCP client config.

# --- ninaAPI (Advanced API plugin) connection ---
# Host running NINA with the "Advanced API" plugin installed and enabled.
NINA_HOST=127.0.0.1
# Port configured for the Advanced API plugin (its own default is 1888).
NINA_PORT=1888

# --- Target Scheduler database (read/edit via SQLite; see tools/target_scheduler.py) ---
# Default matches the documented Windows path. Point this at a network path
# (e.g. \\NINA-PC\...) if this MCP server runs on a different machine than NINA.
# TS_DB_PATH=C:\Users\<you>\AppData\Local\NINA\SchedulerPlugin\schedulerdb.sqlite

# Set to true only once you're comfortable with an agent editing your Target
# Scheduler database (project/target priorities, enabled flags, etc).
TS_ALLOW_WRITES=false
